# Register an OAuth application at https://osu.ppy.sh/home/account/edit#oauth
# Its "Application Callback URL" must match OSU_REDIRECT_URI exactly.
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=

# Local development (npm run dev): the Vite dev server proxies /api to the backend.
OSU_REDIRECT_URI=http://localhost:5173/api/auth/callback
PUBLIC_URL=http://localhost:5173

# Production: use your public HTTPS origin instead, e.g.
#   PUBLIC_URL=https://editor.example.com
#   OSU_REDIRECT_URI=https://editor.example.com/api/auth/callback

PORT=8787

# Supabase project (osu! accounts and sessions). Settings → API Keys → service_role (legacy) key.
# Server-side only: never expose the service role key to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Google Drive sync (optional): an OAuth client of type "Web application" in Google Cloud Console, with the
# drive.file scope on its consent screen and $PUBLIC_URL/api/drive/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
