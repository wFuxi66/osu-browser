# Register an OAuth application at https://osu.ppy.sh/home/account/edit#oauth
# Callback URL must match OSU_REDIRECT_URI exactly.
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=
OSU_REDIRECT_URI=http://localhost:5173/api/auth/callback
# Where the browser should land after login (the frontend origin)
PUBLIC_URL=http://localhost:5173
PORT=8787
# Directory for the SQLite database and uploaded map packages
DATA_DIR=./data
