{
  "name": "osumappingweb",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"node --watch server/index.ts\"",
    "dev:web": "vite",
    "dev:api": "node --watch server/index.ts",
    "build": "tsc -p . && vite build",
    "start": "node server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p . && tsc -p server"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "jszip": "^3.10.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
